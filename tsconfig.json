{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2019",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "allowJs": false,
    "noEmit": true,
    "noEmitOnError": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitThis": true
  },
  "include": [
    "./types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".cache",
    ".tmp",
    "build",
    "dist",
    "src/admin",
    "src/plugins/**/admin"
  ]
}
